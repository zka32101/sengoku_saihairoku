rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // users/{userId} とそのサブコレクション（battles, battle_pass, wallet,
    // wallet_transactions, ad_rewards, friends, purchases, achievements,
    // milestones, event_progress, collection/warlords 等）はすべて
    // 本人のみが読み書きできる。Cloud Functions（管理者権限）は
    // このルールをバイパスして fcmToken 等を参照・更新できる。
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // rankings/{rankingId}：グローバルランキング表示のため、サインイン済み
    // ユーザーなら誰でも閲覧可能。書き込みは自分のスコアの新規作成のみ許可し
    // （FirebaseService.saveBattleResult は常に新規ドキュメントIDを使う）、
    // 既存の記録の改ざん（update/delete）はクライアントから許可しない。
    match /rankings/{rankingId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // friend_codes/{code}：コード→userId の逆引き。コードは自分の userId から
    // 決定的に導出されるため、書き込みは「自分自身を指すコード」のみ許可する。
    match /friend_codes/{code} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // events/{eventId}：期間限定イベントチャレンジの配信データ。
    // 運営がFirestoreコンソール/管理SDK経由で作成する想定のため、
    // クライアントからの書き込みは常に拒否する。
    match /events/{eventId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // shared_replays/{code}：共有コードを知っていれば誰でも観戦できる
    // 仕様のため read は認証済みなら誰でも許可。作成は自分自身が
    // sharedBy として記録される新規ドキュメントのみ許可する。
    match /shared_replays/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.sharedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // config/{doc}：アプリ設定。運営のみが更新する読み取り専用データ。
    match /config/{document} {
      allow read: if signedIn();
      allow write: if false;
    }

    // battle_results/{id}, message_records/{id}：FirebaseManager が
    // 定義しているが現状どこからも呼び出されていないレガシーコレクション。
    // 将来使われる場合に備え、他コレクションと同じ所有者ベースの制限を
    // かけておく。
    match /battle_results/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /message_records/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
