rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // users/{userId} とそのサブコレクション（battles, battle_pass, wallet,
    // wallet_transactions, ad_rewards, friends, achievements,
    // milestones, event_progress, collection/warlords 等）はすべて
    // 本人のみが読み書きできる。Cloud Functions（管理者権限）は
    // このルールをバイパスして fcmToken 等を参照・更新できる。
    //
    // purchases サブコレクションのみ例外。IAPレシートのサーバー検証
    // （functions/index.js の onPurchaseRecordCreated）が完了するまで
    // statusを'pending'のまま保ち、verified/rejectedへの更新は
    // Cloud Functions（管理者権限、本ルールの適用対象外）のみが行う。
    // クライアントが直接 status を 'verified' に書き換えて不正にゴールド等を
    // 自己付与することを防ぐため、以下の2点を明示的に禁止する：
    //   1. 汎用ワイルドカード（22行目以降）から purchases を除外
    //   2. purchases専用ルールで、status自体の更新を一切許可しない
    //      （クライアントが書けるのは作成時と、付与済みフラグgrantedのみ）
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /purchases/{purchaseId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.status == 'pending'
          && !('granted' in request.resource.data);
        allow update: if isOwner(userId)
          && resource.data.status == 'verified'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['granted'])
          && request.resource.data.granted == true;
        allow delete: if false;
      }

      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(userId) && subcollection != 'purchases';
      }
    }

    // rankings/{rankingId}：グローバルランキング表示のため、サインイン済み
    // ユーザーなら誰でも閲覧可能。書き込みは自分のスコアの新規作成のみ許可し
    // （FirebaseService.saveBattleResult は常に新規ドキュメントIDを使う）、
    // 既存の記録の改ざん（update/delete）はクライアントから許可しない。
    match /rankings/{rankingId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // friend_codes/{code}：コード→userId の逆引き。コードは自分の userId から
    // 決定的に導出されるため、書き込みは「自分自身を指すコード」のみ許可する。
    match /friend_codes/{code} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // events/{eventId}：期間限定イベントチャレンジの配信データ。
    // 運営がFirestoreコンソール/管理SDK経由で作成する想定のため、
    // クライアントからの書き込みは常に拒否する。
    match /events/{eventId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // shared_replays/{code}：共有コードを知っていれば誰でも観戦できる
    // 仕様のため read は認証済みなら誰でも許可。作成は自分自身が
    // sharedBy として記録される新規ドキュメントのみ許可する。
    // likes フィールドのみ、サインイン済みなら誰でもインクリメント更新できる
    // （観戦者からの「いいね」用。他フィールドの改ざんはhasOnlyで防ぐ）。
    match /shared_replays/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.sharedBy == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if false;

      // shared_replays/{code}/comments/{commentId}：観戦者からの短い
      // コメント。読み取りは親ドキュメントと同様誰でも可、投稿は
      // 自分自身がauthorUserIdとして記録される新規ドキュメントのみ許可。
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorUserId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // rankings_{scenario}_{yyyy-MM}：シーズン制（月次）の自己ベストランキング。
    // コレクション名にシナリオ・シーズンを埋め込むことでシーズンごとの
    // 実質リセットを実現している（RankingRepository参照）。読み取りは
    // サインイン済みなら誰でも可、書き込みは自分のドキュメント
    // （{userId}_{scenarioId}）のみ許可する。
    match /{collectionId}/{docId} {
      allow read: if signedIn() && collectionId.matches('^rankings_.*');
      allow create, update: if signedIn()
        && collectionId.matches('^rankings_.*')
        && request.resource.data.userId == request.auth.uid
        && docId == request.auth.uid + '_' + request.resource.data.scenarioId;
      allow delete: if false;
    }

    // config/{doc}：アプリ設定。運営のみが更新する読み取り専用データ。
    match /config/{document} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
